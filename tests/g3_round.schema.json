{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "G3 admission sidecar for one immutable candidate round",
  "description": "The commander round record references this file and its SHA256. Writer and collector enforce temporal, identity and supersession constraints beyond this structural schema.",
  "type": "object",
  "required": ["schema", "repository", "candidate_sha", "round_id", "workflow", "revision", "pr_policy", "partial_rerun_policy", "requests"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": 1},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "round_id": {"type": "string", "minLength": 1},
    "workflow": {"const": ".github/workflows/candidate.yml"},
    "revision": {"type": "integer", "minimum": 1},
    "pr_policy": {"enum": ["forbid", "candidate-checkout-with-merge-tools"]},
    "partial_rerun_policy": {"const": "whole-candidate-job"},
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nonce", "requested_at", "dispatch_ref", "event", "state", "supersedes"],
        "properties": {
          "nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
          "requested_at": {"type": "string", "format": "date-time"},
          "dispatch_ref": {"type": ["string", "null"]},
          "event": {"enum": ["workflow_dispatch", "pull_request"]},
          "state": {"enum": ["dispatch_pending", "bound"]},
          "run_id": {"type": "integer", "minimum": 1},
          "tools_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "request": {"type": "object"},
          "response": {"type": "object"},
          "admission": {"type": "object"},
          "supersedes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["run_id", "run_attempt"],
              "additionalProperties": false,
              "properties": {
                "run_id": {"type": "integer", "minimum": 1},
                "run_attempt": {"type": "integer", "minimum": 1}
              }
            }
          }
        },
        "additionalProperties": false,
        "allOf": [{"if": {"properties": {"state": {"const": "bound"}}}, "then": {"required": ["run_id", "tools_sha"]}}]
      }
    }
  }
}
