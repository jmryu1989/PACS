      "firstName": "방사선",
      "lastName": "사",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "technician"
      ],
      "groups": [
        "/hallym"
      ]
    },
    {
      "username": "kdoctor",
      "email": "kdoctor@kin.kr",
      "firstName": "판독",
      "lastName": "센터의",
      "enabled": true,
      "emailVerified": true,
