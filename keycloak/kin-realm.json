{
  "realm": "kin",
  "displayName": "Korea Imaging Network",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "passwordPolicy": "length(8)",
  "loginTheme": "kin-login",
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 14400,
  "ssoSessionMaxLifespan": 43200,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "roles": {
    "realm": [
      {
        "name": "radiologist",
        "description": "판독의 — 판독문 작성·승인"
      },
      {
        "name": "technician",
        "description": "방사선사 — 검사 확인(Verify), 오더 매칭"
      },
      {
        "name": "admin",
        "description": "관리자"
      }
    ]
  },
  "clients": [
    {
      "clientId": "kin-web",
      "name": "HPACS-lite Web",
      "enabled": false,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "https://localhost:9443",
      "redirectUris": [
        "https://pacs.koreaimagingnetwork.com/*",
        "https://localhost:9443/*",
        "https://127.0.0.1:9443/*"
      ],
      "webOrigins": [
        "https://pacs.koreaimagingnetwork.com",
        "https://localhost:9443",
        "https://127.0.0.1:9443"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "kin-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "kin-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "kin-institution-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "claim.name": "groups"
          }
        }
      ]
    },
    {
      "clientId": "kin-bff",
      "name": "KIN BFF",
      "enabled": true,
      "publicClient": false,
      "secret": "${KC_WEB_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "https://pacs.koreaimagingnetwork.com/api/auth/callback",
        "https://localhost:9443/api/auth/callback",
        "https://127.0.0.1:9443/api/auth/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "kin-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "kin-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "kin-institution-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "claim.name": "groups"
          }
        }
      ]
    },
    {
      "clientId": "kin-api",
      "name": "KIN API (service account)",
      "enabled": true,
      "publicClient": false,
      "secret": "${KC_KIN_API_SECRET}",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "jmryu",
      "email": "jmryu@kin.kr",
      "firstName": "정모",
      "lastName": "류",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "radiologist",
        "technician",
        "admin"
      ],
      "groups": [
        "/hallym"
      ]
    },
    {
      "username": "doctor",
