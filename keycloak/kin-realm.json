      "firstName": "센터",
      "lastName": "기사",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "technician"
      ],
      "groups": [
        "/kin-center"
      ]
    },
    {
      "username": "doctor2",
      "email": "doctor2@kin.kr",
      "firstName": "판독",
      "lastName": "이",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "radiologist"
      ],
      "groups": [
        "/hallym"
      ]
    },
    {
      "username": "service-account-kin-api",
      "enabled": true,
      "serviceAccountClientId": "kin-api",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "query-groups",
          "view-realm"
        ]
      }
    }
  ],
  "groups": [
    {
      "name": "hallym",
      "path": "/hallym",
      "attributes": {},
      "realmRoles": [],
      "clientRoles": {},
      "subGroups": []
