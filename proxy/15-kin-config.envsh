#!/bin/sh
# nginx 공식 entrypoint가 이 파일을 source하므로 export한 파생값을 뒤의 envsubst가 받는다.
# 별도 프로세스인 .sh로 만들면 PUBLIC_PORT_SUFFIX가 사라져 운영 URL에 빈 변수가 남는다.

: "${ORTHANC_USER:?ORTHANC_USER is required}"
: "${ORTHANC_PASS:?ORTHANC_PASS is required}"

PUBLIC_PORT="${PUBLIC_PORT:-9443}"
case "$PUBLIC_PORT" in
  ''|*[!0-9]*) echo "[kin-proxy] PUBLIC_PORT must be numeric" >&2; return 1 ;;
esac

DEPLOYMENT_MODE="${DEPLOYMENT_MODE:-development}"
SERVER_NAME="${SERVER_NAME:-_}"
if [ "$DEPLOYMENT_MODE" = "production" ]; then
  if [ "$PUBLIC_PORT" != "443" ] || [ "$SERVER_NAME" != "pacs.koreaimagingnetwork.com" ]; then
    echo "[kin-proxy] production requires the public PACS host on port 443" >&2
    return 1
  fi
  TLS_CERTIFICATE="${TLS_CERTIFICATE:-/etc/letsencrypt/live/$SERVER_NAME/fullchain.pem}"
  TLS_CERTIFICATE_KEY="${TLS_CERTIFICATE_KEY:-/etc/letsencrypt/live/$SERVER_NAME/privkey.pem}"
else
  TLS_CERTIFICATE="${TLS_CERTIFICATE:-/etc/nginx/certs/kin.crt}"
  TLS_CERTIFICATE_KEY="${TLS_CERTIFICATE_KEY:-/etc/nginx/certs/kin.key}"
fi

if [ "$PUBLIC_PORT" = "443" ]; then
  PUBLIC_PORT_SUFFIX=""
else
  PUBLIC_PORT_SUFFIX=":$PUBLIC_PORT"
fi

export PUBLIC_PORT PUBLIC_PORT_SUFFIX SERVER_NAME TLS_CERTIFICATE TLS_CERTIFICATE_KEY

SNIPPET_DIR=/etc/nginx/snippets
mkdir -p "$SNIPPET_DIR"
umask 077

ORTHANC_BASIC="$(printf '%s' "$ORTHANC_USER:$ORTHANC_PASS" | base64 | tr -d '\n')"
printf 'proxy_set_header Authorization "Basic %s";\n' "$ORTHANC_BASIC" \
  > "$SNIPPET_DIR/orthanc-basic-auth.conf"

if [ "$DEPLOYMENT_MODE" = "production" ]; then
  # 다른 Host로 온 요청의 기록도 nginx.conf.template의 두 server와 같은 기준이다: query에 원본 다운로드 grant가 있으면
  # 이미지 기본(main, 요청 줄 전체) 대신 query 없는 형식으로만 남긴다(S9-U4b U4C-01). 변수는 그 template의 http map이다.
  printf '%s\n' \
    'server {' \
    '    listen 80 default_server;' \
    '    server_name _;' \
    '    access_log /var/log/nginx/access.log main if=$kin_plain_log;' \
    '    access_log /var/log/nginx/access.log kin_original_archive if=$kin_grant_query;' \
    '    return 444;' \
    '}' \
    'server {' \
    '    listen 443 ssl default_server;' \
    '    http2 on;' \
    '    server_name _;' \
    "    ssl_certificate     $TLS_CERTIFICATE;" \
    "    ssl_certificate_key $TLS_CERTIFICATE_KEY;" \
    '    ssl_protocols TLSv1.2 TLSv1.3;' \
    '    access_log /var/log/nginx/access.log main if=$kin_plain_log;' \
    '    access_log /var/log/nginx/access.log kin_original_archive if=$kin_grant_query;' \
    '    return 444;' \
    '}' > "$SNIPPET_DIR/default-servers.conf"

  printf '%s\n' \
    'location ^~ /.well-known/acme-challenge/ {' \
    '    root /var/www/certbot;' \
    '    default_type text/plain;' \
    '    try_files $uri =404;' \
    '}' > "$SNIPPET_DIR/acme-challenge.conf"

  printf '%s\n' \
    'add_header Strict-Transport-Security "max-age=31536000" always;' \
    > "$SNIPPET_DIR/hsts.conf"

else
  : > "$SNIPPET_DIR/default-servers.conf"
  : > "$SNIPPET_DIR/acme-challenge.conf"
  : > "$SNIPPET_DIR/hsts.conf"
fi

# 개발 프록시도 외부 진입점이 될 수 있다. 배포 모드와 관계없이 관리 표면을 숨긴다.
printf '%s\n' \
  'location = /auth/admin { return 404; }' \
  'location ^~ /auth/admin/ { return 404; }' \
  'location = /auth/realms/master { return 404; }' \
  'location ^~ /auth/realms/master/ { return 404; }' \
  > "$SNIPPET_DIR/keycloak-admin-guards.conf"

# EMR-E 영상 경계(E_ROUTE). 뷰어의 WADO-RS 프레임 요청을 API의 E 경로(images/dicom-web)로 보내는 location은 배포가
# 뷰어/디코더 자산 목록(KIN_EMR_IMAGE_ASSET_CATALOG, API와 같은 값)을 줄 때만 쓴다: E의 manifest는 그 목록의 실제
# 바이트를 고정해야 하고, 목록 없는 API는 프레임마다 503 ImageAssetCatalogUnavailable만 답해 새 설치의 뷰어가 영상을
# 보여주지 못한다(batch-2 B1). 목록이 없으면 이 파일은 비어 있고 프레임 요청은 기존 /dicom-web/ 경로(authz 부요청 뒤
# Orthanc)로 간다. 켜졌을 때의 규칙: API가 지금의 접근을 확인하고 보낼 바이트를 고정해 B2 provide-prepared 기록과 함께
# 확정한 뒤에만 첫 byte를 쓴다. target은 nginx가 정규화한 $uri뿐이다(정규식이 숫자·점·쉼표·빗금만 통과시키므로 query
# 구분자가 섞일 수 없고, proxy_pass에 변수가 있으면 원 요청의 query는 붙지 않는다). 전송 끝과 중단을 API가 실제 연결에서
# 관측하도록 버퍼링하지 않는다(E-03). Connection을 비워야 upstream keepalive가 되며, location의 proxy_set_header가 서버
# 수준의 것을 가리므로 같은 헤더를 다시 둔다.
if [ -n "${KIN_EMR_IMAGE_ASSET_CATALOG:-}" ]; then
  printf '%s\n' \
    'location ~ ^/dicom-web/studies/[0-9.]+/series/[0-9.]+/instances/[0-9.]+/frames/[0-9]+(,[0-9]+)*$ {' \
    '    limit_except GET HEAD { deny all; }' \
    '    proxy_buffering off;' \
    '    proxy_set_header Connection        "";' \
    '    proxy_set_header Host              $http_host;' \
    '    proxy_set_header X-Real-IP         $remote_addr;' \
    '    proxy_set_header X-Forwarded-For   $remote_addr;' \
    '    proxy_set_header X-Forwarded-Proto https;' \
    '    proxy_set_header X-Forwarded-Host  $http_host;' \
    "    proxy_set_header X-Forwarded-Port  $PUBLIC_PORT;" \
    '    proxy_pass http://kin_api_image/api/images/dicom-web?target=$uri;' \
    '}' \
    > "$SNIPPET_DIR/image-frames.conf"
else
  : > "$SNIPPET_DIR/image-frames.conf"
fi
