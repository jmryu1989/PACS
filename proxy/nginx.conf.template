# KIN 리버스 프록시 — 브라우저가 보는 출처를 하나로 모은다.
# PUBLIC_PORT 계열만 envsubst한다. $host·$request_uri 같은 nginx 변수는 런타임까지 남아야 한다.

limit_req_zone $binary_remote_addr zone=kin_registration:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=kin_token:10m rate=30r/m;
limit_req_status 429;

# S9-U4b 원본 archive(D1489)의 접근 기록: 메서드·정규화한 경로·상태·바이트·시각뿐이다. 그 GET의 query에는 일회용
# 다운로드 grant가 있으므로 $request·$request_uri·$args·$http_referer·Cookie·Authorization은 쓰지 않는다.
log_format kin_original_archive '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent $request_time';
# grant는 정확한 archive 경로에서만 쓰이지만 클라이언트는 다른 표기(대문자 id·끝 빗금·/API/·상태 경로)에도 실어 보낼 수 있다.
# API는 그 요청을 소비 없이 거절하므로 일반 기록에 남은 grant는 만료(120초)까지 유효하다(SRU4-1). 그래서 query에 grant가
# 있으면 이 파일과 15-kin-config.envsh가 만드는 모든 server(기본 server 444 포함)가 위 형식으로만 기록하고, archive 경로가
# 아니면 upstream에 보내지 않고 server 수준에서 거절한다 — upstream 오류·deny의 원문 오류 기록과 HTTP→HTTPS 리다이렉트의
# Location은 요청 줄·query를 그대로 싣기 때문이다(U4C-01).
# "grant"의 표기: nginx는 $args를 디코딩하지 않지만 받는 쪽은 디코딩하므로 대소문자와 각 글자의 퍼센트 인코딩(%67rant·
# %47%52%41%4E%54), 그 인코딩 앞에 %25를 몇 번 더 붙인 것(%2567rant·%252567rant)을 같은 글자로 본다. 한 글자의 16진 숫자까지
# 따로 인코딩한 것(%25%36%37rant)은 이 판정 밖이다 — API는 query 전체가 문자 그대로 `grant=<43자>`일 때만 grant로 받으므로 그런
# 표기는 쓸 수 있는 grant 키가 아니다(SRU4R3-3).
# - kin_grant_key: query($args)의 어느 키가 그 표기로 시작한다(첫 키 또는 & ; 뒤). 443의 거절은 이 판정만 쓴다 — 값 속의
#   낱말(검색어 "grantham")은 키가 아니므로 막지 않는다.
# - kin_grant_query: 그 낱말이 요청 줄($request) 어디에든 있다(경로·다른 키의 값 포함). $args가 아니라 요청 줄로 보는 것은
#   nginx가 URI를 다 읽기 전에 끝낸 요청(414 등)에는 $args가 없고 이미지 main 기록은 요청 줄 전체를 싣기 때문이다(SRU4R3-2).
#   기록과 80 server의 거절을 이것으로 고른다 — 넓게 잡아도 그 요청의 query가 기록에서 빠지거나 HTTP 요청이 400일 뿐이다.
map $args $kin_grant_key {
    default                                                                                         0;
    "~*(^|[&;])(g|%(25)*[46]7)(r|%(25)*[57]2)(a|%(25)*[46]1)(n|%(25)*[46]e)(t|%(25)*[57]4)"         1;
}
map $request $kin_grant_query {
    default                                                                                         0;
    "~*(g|%(25)*[46]7)(r|%(25)*[57]2)(a|%(25)*[46]1)(n|%(25)*[46]e)(t|%(25)*[57]4)"                 1;
}
# HTTP→HTTPS 리다이렉트가 싣는 경로: 원문 요청 URI의 ? 앞까지. query는 옮기지 않는다(SRU4R3-3).
map $request_uri $kin_request_path {
    default      /;
    "~^(?<kin_path>[^?]*)"  $kin_path;
}map $kin_grant_query $kin_plain_log {
    0       1;
    default 0;
}
map "$kin_grant_key:$uri" $kin_grant_outside_archive {
    default                                                            0;
    "~^1:/api/studies/[0-9.]+/original-downloads/[0-9a-f-]+/archive$"  0;
    "~^1:"                                                             1;
}
# 그 archive의 API 연결은 응답 뒤에도 nginx가 먼저 끊지 않는다(keepalive). 끊으면 API의 writer가 마지막 byte를 넘긴 뒤 자기
# 응답을 끝내기 전에 연결이 닫혀, 끝까지 받은 다운로드가 Incomplete로 기록된다(S9-U4b (c) r2, hosted G3 dfca33a: nginx 200 전체
# byte, API attempt aborted·responseFinished false).
upstream kin_api_archive {
    server api:3000;
    keepalive 8;
}

include /etc/nginx/snippets/default-servers.conf;

server {
    listen 80;
    server_name ${SERVER_NAME};
    # 이 server는 리다이렉트만 하므로 query가 기록에 쓸모없다: 모든 요청을 query 없는 archive 형식으로만 기록한다 — 판정 밖의
    # 표기(SRU4R3-3)도 남지 않는다. 443 server와 기본 server(15-kin-config.envsh)는 grant 없는 요청에 이미지 main 기록을 둔다.
    access_log /var/log/nginx/access.log kin_original_archive;
    # 브라우저는 HTTP로 grant를 보내지 않는다. 요청 줄에 그 낱말이 있으면(어느 표기·위치든) 옮기지 않고 거절하고, 그 밖의
    # 리다이렉트도 경로만 옮기고 query는 버린다 — 어떤 값도 Location·브라우저 기록에 실리지 않는다(U4C-01, SRU4R3-3).
    if ($kin_grant_query) { return 400; }

    include /etc/nginx/snippets/acme-challenge.conf;

    # 서버 수준 return은 location 선택보다 먼저 실행되어 ACME webroot까지 리다이렉트한다.
    # challenge만 예외로 남기기 위해 일반 요청의 리다이렉트를 location에 둔다.
    location / {
        return 301 https://$host${PUBLIC_PORT_SUFFIX}$kin_request_path;
    }
}

server {
    listen 443 ssl;
    http2 on;
    # A11-OUTPUT / s9u4 re-login: 기본 keepalive_requests 1000 / keepalive_time 1h의 GOAWAY와
    # Chromium의 새 스트림 생성이 겹치면 요청이 ERR_FAILED로 사라진다. OHIF의 HTTP/2 병렬 요청을
    # 유지하며 계정 전환 84회에서 관측한 총 14580요청보다 위에서 연결을 교체한다.
    # 새 한도와 1h 만료의 경합은 남는다. 더 큰 기관/영상 부하에서는 먼저 다시 계측한다.
    keepalive_requests 14581;
    server_name ${SERVER_NAME};

    ssl_certificate     ${TLS_CERTIFICATE};
    ssl_certificate_key ${TLS_CERTIFICATE_KEY};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    # nginx가 컨테이너의 443으로 절대 URL을 만들면 로컬 호스트의 9443을 잃는다.
    # 상대 리다이렉트는 브라우저가 현재 보고 있는 출처를 그대로 보존한다.
    absolute_redirect off;

    # 전역 기본. 큰 본문을 받는 곳은 Gateway 전용 지정형 STOW(아래 /dicom-web/studies/<uid>)와 member 반입의
    # 정확 경로(location = /api/dicom-import) 둘뿐이다. 그 밖의 DICOM 쓰기는 limit_except로 막혀 있고 나머지 /api/는 2m이다.
    client_max_body_size 32m;
    proxy_read_timeout   300s;
    proxy_send_timeout   300s;

    proxy_http_version 1.1;
    proxy_set_header Host              $http_host;
    proxy_set_header X-Real-IP         $remote_addr;
    # 접속지는 프록시가 본 주소 하나다(S7-U5 A007·SEA-F04). 클라이언트가 보낸 X-Forwarded-For를 앞에 이어 붙이지 않는다 —
    # Keycloak은 이 머리글의 맨 앞 값을 접속지로 읽으므로(KC_PROXY_HEADERS=xforwarded), 이 서버 수준 값을 물려받는
    # location(가입 제출·토큰 교환의 정확 경로 등)에서 클라이언트가 고른 주소가 기록·제한의 기준이 되었다. API는 X-Real-IP만 읽는다.
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host  $http_host;
    proxy_set_header X-Forwarded-Port  ${PUBLIC_PORT};

    include /etc/nginx/snippets/hsts.conf;
    include /etc/nginx/snippets/keycloak-admin-guards.conf;

    # Keycloak 계정 콘솔(S7-U5 A018). 제품은 이 화면을 쓰지 않고 어디에서도 가리키지 않는다. 열어 두면 Keycloak 자신의
    # SSO만으로 열려 제품의 콜백(끝내기로 한 세션을 막는 자리)을 지나지 않는다 — 제품이 세션을 끝낸 뒤 인증 서버의 종료가
    # 확인되기 전의 틈에 다음 사람이 앞사람의 계정 화면에 닿는다. 로그인·가입·비밀번호 재설정·필수 동작
    # (login-actions, protocol/openid-connect)과 테마 자산(resources)은 다른 경로라 영향이 없다.
    # 정확 경로 둘이 아니라 대소문자를 가리지 않는 정규식 하나다(SEA-F05): `account;x=1`(행렬 매개변수 — Keycloak의 경로
    # 대조는 무시한다), `account/…`, `ACCOUNT`, 그리고 nginx가 대조 전에 정규화하는 %-인코딩(`%61ccount`)·겹친 빗금·`/./`·
    # `/../` 표기가 모두 여기서 끝난다. 이 경로 아래에는 prefix `^~` location이 없으므로 정규식이 `/auth/`보다 먼저 맞는다.
    location ~* ^/auth/realms/kin/account { return 404; }

    # Optional, administrator-owned auxiliary routes. Empty on installations
    # without workflow collection; no credentials or captured data live here.
    include /etc/nginx/workflow/*.conf;

    # 토큰이 브라우저 저장소에 남는 이행 기간에는 외부 스크립트와 외부 연결을 막아
    # XSS의 계정 탈취 반경을 줄인다. inline은 현 단일 HTML 프론트 때문에 아직 필요하다.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; object-src 'self' blob:; frame-src 'self' blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # 직접 DICOM 요청의 인증 거절이 어느 거절인지(S7-U5): 인증 서브요청(/kin-authz)은 본문을 전달하지 못하므로 API가
    # 실은 X-KIN-Auth-Code를 보호 경로의 401/403 응답에 그대로 옮긴다. 값이 비면 nginx는 이 헤더를 내지 않는다 —
    # 코드 없는 403은 평범한 열람 거절이다. 위 세 보안 헤더와 같은 수준에 두어야 보호 location이 넷을 함께 물려받는다.
    set $kin_auth_code "";
    add_header X-KIN-Auth-Code $kin_auth_code always;
    # nginx가 머리글을 읽다 끝낸 요청(잘못된 머리글 줄·중복 Host·494/400·414)은 위 set(rewrite 단계)에 닿지 않아 오류 응답의
    # add_header가 이 변수를 미초기화로 읽고, 그 경고(notice)는 요청 줄을 query째 이미지 오류 기록에 싣는다 — archive grant
    # 포함(SRU4R3-1). 이 변수는 지금처럼 set + auth_request_set으로 두고(map 기본값으로도 바꿀 수 있지만 그 선택이 필요한 것은
    # 아니다), 이 server에서 미초기화로 읽힐 수 있는 변수가 이것 하나이며 그때 값은 비어(머리글을 내지 않는다) 경고가 알려 줄
    # 것이 없으므로 경고를 끈다(U4C3-2).
    uninitialized_variable_warn off;

    # grant가 실린 요청의 기록(위 map). archive location은 자기 access_log를 둔다. archive 경로 밖의 grant 키는 location을
    # 고르기 전에 400으로 끝나 upstream·deny·workflow location에 닿지 않으므로 원문 오류 기록이 생기지 않는다.
    access_log /var/log/nginx/access.log main if=$kin_plain_log;
    access_log /var/log/nginx/access.log kin_original_archive if=$kin_grant_query;
    if ($kin_grant_outside_archive) { return 400; }

    location = / { return 302 /worklist/hpacs-lite/index.html; }

    # This directory contains only the collector's four-field public heartbeat.
    # No backup/state/credential directory is mounted into nginx for monitoring.
    location = /ops-status.json {
        alias /var/run/kin-monitor-public/status.json;
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        limit_except GET HEAD { deny all; }
    }

    # 가입 신청은 BFF가 state·PKCE를 만든 뒤 Keycloak으로 보낸다. 진입점과 실제 등록
    # 제출을 같은 제한 구역에 넣어 새 계정 생성 입력면을 양쪽에서 막는다.
    location = /api/auth/register {
        limit_req zone=kin_registration burst=5 nodelay;
        client_max_body_size 2m;
        proxy_pass http://api:3000;
    }

    location = /api/dicom-import {
        # DICOM 객체는 크기로 거절하지 않는다. 나머지 /api/는 2m 그대로.
        client_max_body_size 0;
        proxy_pass http://api:3000;
    }

    # S9-U4b 원본 archive GET(D1489): 브라우저 자체 다운로드의 일회용 grant가 query에 실린다. 이 location은 위
    # kin_original_archive 형식으로만 기록하고, nginx 원문 오류 기록(요청 줄을 그대로 싣는다)은 남기지 않는다 — 진단은
    # API의 감사·상태로 한다. 큰 archive는 버퍼링 없이 흘린다(수신·저장의 증명은 아니다). 정규식이라 /api/보다 먼저 맞는다.
    location ~ ^/api/studies/[0-9.]+/original-downloads/[0-9a-f-]+/archive$ {
        access_log /var/log/nginx/access.log kin_original_archive;
        error_log /dev/null;
        proxy_buffering off;
        client_max_body_size 2m;
        # Connection을 비워야 upstream keepalive가 된다. 이 location이 proxy_set_header를 두므로 서버 수준의 것을 그대로 다시 둔다.
        proxy_set_header Connection        "";
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Port  ${PUBLIC_PORT};
        proxy_pass http://kin_api_archive;
    }

    location /api/ {
        # 판독문·필터·상용구 JSON뿐이다. 2MB면 넉넉하고, 그 이상은 실수 아니면 공격이다.
        client_max_body_size 2m;
        proxy_pass http://api:3000;
    }

    location = /auth/realms/kin/login-actions/registration {
        limit_req zone=kin_registration burst=5 nodelay;
        proxy_pass http://keycloak:8080;
        proxy_buffer_size       16k;
        proxy_buffers        8  16k;
        proxy_busy_buffers_size 32k;
    }

    location = /auth/realms/kin/protocol/openid-connect/token {
        limit_req zone=kin_token burst=10 nodelay;
        proxy_pass http://keycloak:8080;
        proxy_buffer_size       16k;
        proxy_buffers        8  16k;
        proxy_busy_buffers_size 32k;
    }

    # 토큰과 쿠키가 커서 기본 프록시 버퍼로는 응답 헤더가 넘칠 수 있다.
    location /auth/ {
        # Keycloak 로그인 템플릿은 단일 favicon.ico 링크만 낸다. 테마 템플릿을
        # 복제하지 않고 그 링크만 J1 SVG + 32px PNG 폴백으로 확장한다.
        proxy_set_header Accept-Encoding "";
        # 이 location이 자기 proxy_set_header를 두므로 서버 수준의 것은 물려받지 않는다(S7-U5 A007): 접속지를 여기서
        # 다시 정하지 않으면 클라이언트가 보낸 X-Real-IP·X-Forwarded-For가 그대로 Keycloak에 닿는다. 프록시가 본 주소로
        # 덮어쓴다 — 클라이언트가 보낸 값은 이어 붙이지 않고 버린다.
        proxy_set_header X-Real-IP       $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://keycloak:8080;
        proxy_buffer_size       16k;
        proxy_buffers        8  16k;
        proxy_busy_buffers_size 32k;
        sub_filter_once off;
        sub_filter 'img/favicon.ico" />' 'img/kin-emblem-j1.svg" type="image/svg+xml" /><link rel="icon" type="image/png" sizes="32x32" href="/kin-brand/kin-favicon-32.png" />';
    }

    # 브라우저에 Orthanc 자격증명을 주지 않는다. 공개 경로 일곱 곳이 같은 include를
    # 읽어야 비밀번호 교체 때 한 곳만 낡은 헤더로 남는 일이 없다.
    location /worklist/ {
        # OHIF와 같은 cross-origin isolation 상태와 browsing context group에 남아야
        # 이름 붙인 팝업 핸들이 navigation 뒤에도 산다.
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        proxy_pass http://orthanc:8042;
        include /etc/nginx/snippets/orthanc-basic-auth.conf;
    }

    # 내장 뷰어의 번들을 포크하지 않는다. 브라우저 셸에 필요한 KIN 자산만 프록시가
    # 직접 제공하고, 실제 헤더/도구 브랜딩은 app-config.js의 whiteLabeling이 맡는다.
    location ^~ /kin-brand/ {
        alias /usr/share/nginx/html/kin-brand/;
        add_header Cache-Control "public, max-age=3600";
    }

    location = /ohif/manifest.json {
        alias /usr/share/nginx/html/kin-brand/viewer-manifest.json;
        default_type application/manifest+json;
    }

    location /ohif/ {
        # sub_filter가 압축된 HTML에는 적용되지 않는다. 번들/CSS는 그대로 통과시키고
        # text/html 응답의 고정 title·favicon 메타만 KIN 브라우저 셸로 바꾼다.
        proxy_set_header Accept-Encoding "";
        proxy_pass http://orthanc:8042;
        include /etc/nginx/snippets/orthanc-basic-auth.conf;
        sub_filter_once off;
        sub_filter '<meta name="application-name" content="OHIF Viewer"/>' '<meta name="application-name" content="KIN 판독 뷰어"/>';
        sub_filter '<meta name="apple-mobile-web-app-title" content="@ohif/app"/>' '<meta name="apple-mobile-web-app-title" content="KIN 판독 뷰어"/>';
        sub_filter '<meta name="msapplication-TileImage" content="./assets/mstile-144x144.png"/>' '<meta name="msapplication-TileImage" content="/kin-brand/kin-favicon-32.png"/>';
        sub_filter '<link rel="shortcut icon" href="./assets/favicon.ico"/>' '';
        sub_filter '<link rel="icon" type="image/png" sizes="16x16" href="./assets/favicon-16x16.png"/>' '';
        sub_filter '<link rel="icon" type="image/png" sizes="32x32" href="./assets/favicon-32x32.png"/>' '<link rel="icon" type="image/svg+xml" href="/kin-brand/kin-emblem-j1.svg"/><link rel="icon" type="image/png" sizes="32x32" href="/kin-brand/kin-favicon-32.png"/>';
        sub_filter '<link rel="icon" type="image/png" sizes="228x228" href="./assets/coast-228x228.png"/>' '';
        sub_filter '<title>OHIF Viewer</title>' '<title>판독 뷰어 — KOREA IMAGING NETWORK</title>';
    }

    # 검사 UID를 경로에 박은 STOW만 Gateway에 연다. UID 없는 POST는 아래 읽기 전용
    # location에 남아 403이고, API authz가 announce 선행과 기관 일치를 다시 확인한다.
    location ~ ^/dicom-web/studies/[0-9.]+$ {
        client_max_body_size 0;
        limit_except GET HEAD POST { deny all; }
        auth_request /kin-authz;
        auth_request_set $kin_auth_code $upstream_http_x_kin_auth_code;
        proxy_pass http://orthanc:8042;
        include /etc/nginx/snippets/orthanc-basic-auth.conf;
    }

    # 4242만 닫아도 STOW-RS가 열려 있으면 HTTPS로 영상을 쓸 수 있다.
    # 조회도 먼저 API의 토큰 검증을 통과해야 Orthanc 자격증명을 대신 붙인다.
    location /dicom-web/ {
        limit_except GET HEAD { deny all; }
        auth_request /kin-authz;
        auth_request_set $kin_auth_code $upstream_http_x_kin_auth_code;
        proxy_pass http://orthanc:8042;
        include /etc/nginx/snippets/orthanc-basic-auth.conf;
    }

    # 썸네일. 읽기만 — DELETE /instances/{id}는 영상을 지운다.
    location /instances/ {
        limit_except GET HEAD { deny all; }
        auth_request /kin-authz;
        auth_request_set $kin_auth_code $upstream_http_x_kin_auth_code;
        proxy_pass http://orthanc:8042;
        include /etc/nginx/snippets/orthanc-basic-auth.conf;
    }

    location = /statistics {
        limit_except GET HEAD { deny all; }
        auth_request /kin-authz;
        auth_request_set $kin_auth_code $upstream_http_x_kin_auth_code;
        proxy_pass http://orthanc:8042;
        include /etc/nginx/snippets/orthanc-basic-auth.conf;
    }

    location = /system {
        limit_except GET HEAD { deny all; }
        auth_request /kin-authz;
        auth_request_set $kin_auth_code $upstream_http_x_kin_auth_code;
        proxy_pass http://orthanc:8042;
        include /etc/nginx/snippets/orthanc-basic-auth.conf;
    }

    # 내부 인증 서브요청 — API가 Bearer 토큰 또는 kin_sid 쿠키의 로그인 세션을 검증한다.
    # 2xx면 통과하고 401/403이면 원 요청도 거부한다. 외부에서는 직접 부를 수 없다.
    # 401 = 자격 없음·끝난 세션, 403 + X-KIN-Auth-Code = 세션 결속 문제, 코드 없는 403 = 열람 거절(S7-U5).
    location = /kin-authz {
        internal;
        proxy_pass http://api:3000/api/authz/dicom;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Cookie $http_cookie;
        # 접속지(S7-U5 A007). 이 location은 자기 proxy_set_header를 두어 서버 수준의 X-Real-IP를 물려받지 않는다 — 여기서
        # 정하지 않으면 영상 요청이 끝낸 세션(유휴 만료·갱신 거절)의 접속기록에 주소가 없거나, 클라이언트가 보낸 값이
        # 남는다. 프록시가 본 원 요청의 주소로 덮어쓴다(서브요청의 $remote_addr는 원 요청의 것이다).
        proxy_set_header X-Real-IP       $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        # 요청을 시작한 문서가 본 세션의 식별값. API는 이것이 쿠키의 세션과 다르면 거절한다 — 다른 탭의 새 로그인이
        # 옛 문서의 영상 요청을 대신 인증하지 않는다. 쿠키 만료(Set-Cookie)는 이 서브요청에서 원 응답으로 옮기지 않는다.
        proxy_set_header X-KIN-Session $http_x_kin_session;
    }

    # 목록에 없는 Orthanc 관리·삭제 경로는 뒷단으로 넘기지 않는다.
    location / { return 404 "not exposed\n"; }
}
