// Korea Imaging Network — HPACS-lite 백엔드 스키마 (3단계 시작점)
//
// 설계 메모:
// - 영상 자체는 Orthanc(DICOM)가 진실의 원천이다. 이 DB는 "영상에 대한 사람의 결정"만 저장한다.
//   (판독 상태, 판독문, 기사 확인, RIS 오더 매칭, 누가 언제 무엇을 했는지)
// - 그래서 StudyState의 PK는 StudyInstanceUID다. 우리가 발급한 ID가 아니라 DICOM이 발급한 ID.
// - ov/orig 같은 가변 구조는 JSON 문자열로 넣는다. 아직 그 안을 조건으로 검색할 일이 없기 때문.
//   검색이 필요해지는 순간 컬럼으로 승격시킨다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 기관. 병원 하나, 판독센터 하나가 각각 한 행이다.
///
/// 왜 필요한가: Connect(5단계)는 "병원 A의 검사를 병원 B가 본다"이므로,
/// 그 전에 "이 검사는 어느 기관 것인가"가 데이터에 있어야 한다.
/// 지금은 DB 레코드의 소속만 가른다 — 영상 자체(Orthanc)는 아직 하나다.
///
/// dicomNames: DICOM InstitutionName(0008,0080)에 실제로 찍혀 오는 문자열들.
/// 장비마다 표기가 제각각이라("한림병원", "HALLYM", "Hallym Univ. Hospital")
/// 하나의 기관에 여러 별칭이 붙는다. 콤마로 구분해 넣는다.
model Institution {
  id         String   @id                     // "hallym", "kin-center"
  name       String                           // 화면에 보이는 이름
  type       String   @default("hospital")    // hospital | reading-center
  dicomNames String   @default("")            // InstitutionName 별칭, 콤마 구분
  createdAt  DateTime @default(now())
}

/// 검사 하나에 대한 사람의 결정. Orthanc의 검사와 1:1.
model StudyState {
  uid       String   @id                      // StudyInstanceUID

  /// 이 검사를 소유한 기관 = 촬영한 기관. DICOM InstitutionName에서 판정해 처음 볼 때 박는다.
  /// null은 "아직 판정 못 함"이다. 모르는 기관명을 아무 데나 넣지 않는다 —
  /// 남의 병원 검사가 조용히 우리 목록에 섞이는 것이 이 단계에서 가장 나쁜 실패다.
  institutionId   String?
  /// 원격판독을 받은 기관. **이 컬럼 하나만이 기관 경계를 넘게 해주는 통로다.**
  /// TS 상태머신이 wait 이상으로 갈 때 채워지고, 취소하면 비워진다.
  teleInstitutionId String?
  rs        String   @default("W")            // Reading Status: W(대기) T(임시저장) A(승인)
  ss        String   @default("Verified")     // Study Status: Verified / Unverified (기사 확인)
  em        String   @default("N")            // Emergency: E / N
  ts        String   @default("none")         // Tele Status: none→wait→sending→sent→inReading→completed
  matched   String   @default("U")            // RIS 오더 매칭: M / U
  ward      String   @default("")
  reqHosp   String   @default("KIN")
  repDoc    String?                           // 판독의 (Approve 시 기록)
  confirm   String?                           // 판독 확정일

  /// Preliminary(RS=P) — 예비 판독을 쓴 사람과, 최종 판독을 맡긴 상급 판독의.
  ///
  /// RS가 P인 동안 **판독문 내용은 이 두 사람만 볼 수 있다.** 워크리스트에는 보이지만
  /// 내용은 가려진다. 아직 확정되지 않은 소견이 기관 전체에 퍼지면, 나중에 상급자가
  /// 뒤집어도 이미 읽은 사람의 머릿속은 안 뒤집힌다.
  /// (HPACS 매뉴얼 7.4.1.3-4.1 — "지정된 판독의만 판독 내용을 볼 수 있다")
  preDoc      String?
  preReviewer String?
  ov        String?                           // Match/Modify로 덮어쓴 값 (JSON)
  orig      String?                           // 덮어쓰기 전 원본 (JSON) — Unmatch 복원용
  orderOid  String?                           // 매칭된 오더
  holder    String?                           // 지금 판독문을 쓰고 있는 사람
  heldAt    DateTime?                         // 마지막 하트비트. TTL이 지나면 점유가 풀린다
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  report Report?

  @@index([institutionId])
  @@index([teleInstitutionId])
}

/// 판독문의 **현재 내용**. 화면이 빠르게 읽어가는 스냅샷.
model Report {
  uid            String   @id
  findings       String   @default("")
  conclusion     String   @default("")
  recommendation String   @default("")
  version        Int      @default(0)   // 마지막으로 확정된 판(버전)
  updatedBy      String?
  updatedAt      DateTime @updatedAt

  study StudyState @relation(fields: [uid], references: [uid], onDelete: Cascade)
}

/// 아직 확정되지 않은, **쓰는 사람의 것인** 판독문.
///
/// 왜 따로 두는가: 예전엔 초안도 `Report`에 썼다. 그런데 `Report`는 "이 검사의 확정된
/// 판독문"이 있는 자리다. 아직 아무의 진술도 아닌 글을 거기 쓰니까 문제가 줄줄이 나왔다 —
/// 초안이 남의 확정본을 덮고, 두 사람의 초안이 서로를 덮고, Clear 한 번에 승인본이
/// 화면에서 사라졌다. 방어막을 겹겹이 쌓아 막아봤지만 전부 **한 칸을 둘이 쓰는** 것에서
/// 나온 증상이었다.
///
/// 초안을 쓴 사람에게 붙이면 그 셋이 한꺼번에 없어진다. 충돌은 감지할 필요조차 없다 —
/// 애초에 같은 행을 안 쓰기 때문이다. 20초 자동 저장이 남의 것과 부딪힐 일이 없고,
/// 그래서 사용자가 안 보고 있을 때 충돌 대화를 띄울 일도 없다.
///
/// 충돌은 **확정할 때만** 일어난다. 사람이 화면 앞에 있고, 스스로 누른 순간이고,
/// 물어볼 수 있는 자리다. 낙관적 락(`Report.version`)이 거기 하나만 있으면 된다.
///
/// baseVersion: 이 초안을 쓰기 시작할 때 화면에 있던 확정 판.
/// 나중에 돌아왔을 때 "그 사이 남이 v5를 저장했다"를 말해줄 수 있어야 한다.
model ReportDraft {
  uid            String
  author         String
  findings       String   @default("")
  conclusion     String   @default("")
  recommendation String   @default("")
  baseVersion    Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@id([uid, author])
  @@index([uid])
}

/// 판독문의 **역사**. 추가만 하고 고치거나 지우지 않는다(append-only).
///
/// 왜 필요한가: 판독문은 의무기록이다. "누가 언제 무엇이라고 말했는가"가 나중에
/// 뒤집히면 안 된다. Approve된 판독을 고치면 이전 판이 사라지는 구조는
/// 기록이 아니라 메모다. (HPACS 릴리즈노트 교훈 §1)
///
/// action 의미:
///   save      임시 저장 확정 (RS: T)
///   approve   승인 — 이 시점의 내용이 판독의의 진술이 된다 (RS: A)
///   addendum  승인 뒤 덧붙임 — 이전 승인본은 그대로 남는다 (RS: A)
///   reset     판독 취소 후 미판독으로 (RS: W). reason 필수
model ReportVersion {
  id             Int      @id @default(autoincrement())
  uid            String
  version        Int
  action         String
  findings       String   @default("")
  conclusion     String   @default("")
  recommendation String   @default("")
  reason         String?
  author         String
  at             DateTime @default(now())

  @@unique([uid, version])
  @@index([uid])
}

/// RIS(HRIS)에서 넘어온 오더. 지금은 시드 데이터, 4~5단계에서 HL7 v2로 교체된다.
model Order {
  oid       String  @id
  /// 오더를 낸 기관. RIS는 기관마다 따로 돌아간다 — 오더가 기관을 넘는 일은 없다.
  institutionId String @default("hallym")
  patientId String
  name      String
  sex       String
  birth     String
  sched     String
  modality  String
  descr     String
  ward      String
  reqDoc    String
  matched   String  @default("U")
  studyUid  String?

  @@index([institutionId])
}

/// 사용자가 이름 붙여 저장한 워크리스트 필터.
///
/// **계정에 붙는다.** 브라우저가 아니라. 판독의는 자기 필터를 하루 종일 쓰는데,
/// PC를 바꿨다고 초기화되면 깨지는 건 작업이 아니라 신뢰다.
/// HPACS는 이 카테고리 버그를 5년간 반복했고(교훈 §6), 2024년에야 "계정별 저장"에 도달했다.
///
/// isDefault: 로그인하면 자동으로 적용되는 필터. 릴리즈노트의 깃발(⚑) 기능 —
/// "Set default filter … 로그아웃 후 다시 로그인 하여도 해당 필터가 기본으로 적용됩니다."
/// sortKey/sortDir: 정렬도 필터의 일부다. HPACS도 2025년에 "정렬을 적용하여
/// 사용자 필터로 저장" 기능을 넣었다 — 필터만 같고 정렬이 다르면 다른 화면이다.
model UserFilter {
  id        Int      @id @default(autoincrement())
  owner     String                          // 토큰의 actor. 이 사람 것만 보인다
  name      String
  mode      String   @default("Radiology")  // Radiology / Technician
  isDefault Boolean  @default(false)
  quick     String   @default("")           // Quick Search 문자열
  days      Int      @default(-1)           // 날짜 퀵필터 (-1 = All)
  cols      String   @default("{}")         // 컬럼별 필터 값 (JSON)
  sortKey   String?
  sortDir   Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([owner, name])
  @@index([owner])
}

/// 판독 상용구. 매뉴얼이 "Upload/Download **My** Template File"이라고 부르는 그것 —
/// 기관 공용이 아니라 **개인 소유**다. 판독의마다 문장이 다르고, 그게 정상이다.
///
/// 여기도 계정에 붙는다. 필터와 같은 이유다.
model ReadingTemplate {
  id             Int      @id @default(autoincrement())
  owner          String
  title          String
  shortcut       String   @default("")
  modality       String   @default("")   // 선택된 검사와 같은 유형만 보이게 하는 필터용
  bodypart       String   @default("")
  findings       String   @default("")
  conclusion     String   @default("")
  recommendation String   @default("")
  ord            Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([owner])
}

/// 감사 로그. 의료영상 시스템에서 "누가 언제 무엇을 바꿨는가"는 기능이 아니라 요건이다.
model AuditLog {
  id     Int      @id @default(autoincrement())
  at     DateTime @default(now())
  actor  String
  action String
  target String
  detail String?

  @@index([target])
  @@index([at])
}
