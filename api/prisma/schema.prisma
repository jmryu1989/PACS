// Korea Imaging Network — HPACS-lite 백엔드 스키마 (3단계 시작점)
//
// 설계 메모:
// - 영상 자체는 Orthanc(DICOM)가 진실의 원천이다. 이 DB는 "영상에 대한 사람의 결정"만 저장한다.
//   (판독 상태, 판독문, 기사 확인, RIS 오더 매칭, 누가 언제 무엇을 했는지)
// - 그래서 StudyState의 PK는 StudyInstanceUID다. 우리가 발급한 ID가 아니라 DICOM이 발급한 ID.
// - ov/orig 같은 가변 구조는 JSON 문자열로 넣는다. 아직 그 안을 조건으로 검색할 일이 없기 때문.
//   검색이 필요해지는 순간 컬럼으로 승격시킨다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 기관. 병원 하나, 판독센터 하나가 각각 한 행이다.
///
/// 왜 필요한가: Connect(5단계)는 "병원 A의 검사를 병원 B가 본다"이므로,
/// 그 전에 "이 검사는 어느 기관 것인가"가 데이터에 있어야 한다.
/// 지금은 DB 레코드의 소속만 가른다 — 영상 자체(Orthanc)는 아직 하나다.
///
/// dicomNames: DICOM InstitutionName(0008,0080)에 실제로 찍혀 오는 문자열들.
/// 장비마다 표기가 제각각이라("한림병원", "HALLYM", "Hallym Univ. Hospital")
/// 하나의 기관에 여러 별칭이 붙는다. 콤마로 구분해 넣는다.
model Institution {
  id         String   @id                     // "hallym", "kin-center"
  name       String                           // 화면에 보이는 이름
  type       String   @default("hospital")    // hospital | reading-center
  dicomNames String   @default("")            // InstitutionName 별칭, 콤마 구분
  createdAt  DateTime @default(now())
}

/// 검사 하나에 대한 사람의 결정. Orthanc의 검사와 1:1.
model StudyState {
  uid       String   @id                      // StudyInstanceUID

  /// 이 검사를 소유한 기관 = 촬영한 기관. DICOM InstitutionName에서 판정해 처음 볼 때 박는다.
  /// null은 "아직 판정 못 함"이다. 모르는 기관명을 아무 데나 넣지 않는다 —
  /// 남의 병원 검사가 조용히 우리 목록에 섞이는 것이 이 단계에서 가장 나쁜 실패다.
  institutionId   String?
  /// 원격판독을 받은 기관. **이 컬럼 하나만이 기관 경계를 넘게 해주는 통로다.**
  /// TS 상태머신이 wait 이상으로 갈 때 채워지고, 취소하면 비워진다.
  teleInstitutionId String?
  rs        String   @default("W")            // Reading Status: W(대기) T(임시저장) A(승인)
  ss        String   @default("Verified")     // Study Status: Verified / Unverified (기사 확인)
  em        String   @default("N")            // Emergency: E / N
  ts        String   @default("none")         // Tele Status: none→wait→sending→sent→inReading→completed
  matched   String   @default("U")            // RIS 오더 매칭: M / U
  ward      String   @default("")
  reqHosp   String   @default("KIN")
  repDoc    String?                           // 판독의 (Approve 시 기록)
  confirm   String?                           // 판독 확정일
  ov        String?                           // Match/Modify로 덮어쓴 값 (JSON)
  orig      String?                           // 덮어쓰기 전 원본 (JSON) — Unmatch 복원용
  orderOid  String?                           // 매칭된 오더
  holder    String?                           // 지금 판독문을 쓰고 있는 사람
  heldAt    DateTime?                         // 마지막 하트비트. TTL이 지나면 점유가 풀린다
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  report Report?

  @@index([institutionId])
  @@index([teleInstitutionId])
}

/// 판독문의 **현재 내용**. 화면이 빠르게 읽어가는 스냅샷.
model Report {
  uid            String   @id
  findings       String   @default("")
  conclusion     String   @default("")
  recommendation String   @default("")
  version        Int      @default(0)   // 마지막으로 확정된 판(버전)
  updatedBy      String?
  updatedAt      DateTime @updatedAt

  study StudyState @relation(fields: [uid], references: [uid], onDelete: Cascade)
}

/// 판독문의 **역사**. 추가만 하고 고치거나 지우지 않는다(append-only).
///
/// 왜 필요한가: 판독문은 의무기록이다. "누가 언제 무엇이라고 말했는가"가 나중에
/// 뒤집히면 안 된다. Approve된 판독을 고치면 이전 판이 사라지는 구조는
/// 기록이 아니라 메모다. (HPACS 릴리즈노트 교훈 §1)
///
/// action 의미:
///   save      임시 저장 확정 (RS: T)
///   approve   승인 — 이 시점의 내용이 판독의의 진술이 된다 (RS: A)
///   addendum  승인 뒤 덧붙임 — 이전 승인본은 그대로 남는다 (RS: A)
///   reset     판독 취소 후 미판독으로 (RS: W). reason 필수
model ReportVersion {
  id             Int      @id @default(autoincrement())
  uid            String
  version        Int
  action         String
  findings       String   @default("")
  conclusion     String   @default("")
  recommendation String   @default("")
  reason         String?
  author         String
  at             DateTime @default(now())

  @@unique([uid, version])
  @@index([uid])
}

/// RIS(HRIS)에서 넘어온 오더. 지금은 시드 데이터, 4~5단계에서 HL7 v2로 교체된다.
model Order {
  oid       String  @id
  /// 오더를 낸 기관. RIS는 기관마다 따로 돌아간다 — 오더가 기관을 넘는 일은 없다.
  institutionId String @default("hallym")
  patientId String
  name      String
  sex       String
  birth     String
  sched     String
  modality  String
  descr     String
  ward      String
  reqDoc    String
  matched   String  @default("U")
  studyUid  String?

  @@index([institutionId])
}

/// 감사 로그. 의료영상 시스템에서 "누가 언제 무엇을 바꿨는가"는 기능이 아니라 요건이다.
model AuditLog {
  id     Int      @id @default(autoincrement())
  at     DateTime @default(now())
  actor  String
  action String
  target String
  detail String?

  @@index([target])
  @@index([at])
}
