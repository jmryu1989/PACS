# Copy this file to .env and replace every change-me value before starting the stack.
# POSTGRES_PASSWORD is embedded in DATABASE_URL, so use URL-safe characters.
POSTGRES_PASSWORD=change-me-url-safe
# Generate a separate runtime password: at least 24 URL-safe characters (A-Z, a-z, 0-9, _ and -).
# For example, generate it locally with Python secrets.token_urlsafe(32); never reuse the installer password.
KIN_EMR_RUNTIME_PASSWORD=change-me
# EMR-B2: synthetic-stack examples only. Set the verified deployment managing institution before production;
# it is independent of the logged-in member's institution. The proxy host is the nginx service's Docker DNS name.
KIN_EMR_MANAGING_INSTITUTION=synthetic-emr-managing
KIN_EMR_PROXY_HOST=proxy
KC_CLIENT_SECRET=change-me-to-match-the-imported-kin-api-client
KC_WEB_SECRET=change-me
KIN_COOKIE_SECRET=change-me-url-safe
KC_ADMIN_PASSWORD=change-me
ORTHANC_PASS=change-me

# The local port stays outside the Windows Hyper-V reserved range.
PUBLIC_PORT=9443
PUBLIC_ORIGIN=https://localhost:${PUBLIC_PORT}
