# Copy to gateway/.env. Never commit the real values.
GW_ORTHANC_USER=agent
GW_ORTHANC_PASS=change-me
GW_DICOM_PORT=4243
GW_ORTHANC_HTTP_PORT=8043
GW_STABLE_AGE=10

KIN_BASE_URL=https://pacs.koreaimagingnetwork.com
KIN_CLIENT_ID=gw-kin-center
KIN_CLIENT_SECRET=change-me
KIN_TLS_VERIFY=true

# Agent tuning. A STOW request body is kept at or below 24 MiB.
GW_BYTE_BUDGET_MIB=24
GW_POLL_SECONDS=2
GW_HTTP_TIMEOUT_SECONDS=30
GW_STOW_TIMEOUT_SECONDS=300
GW_BACKOFF_BASE_SECONDS=5
GW_BACKOFF_MAX_SECONDS=300
