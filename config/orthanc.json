{
  "Name": "KIN-Lab",

  "RemoteAccessAllowed": true,
  "AuthenticationEnabled": true,
  "RegisteredUsers": {},

  "DicomWeb": {
    "Enable": true,
    "Root": "/dicom-web/"
  },

  "ServeFolders": {
    "/worklist": "/worklist"
  },

  "OHIF": {
    "DataSource": "dicom-web",
    "UserConfiguration": "/etc/orthanc/ohif.js"
  },

  "DicomAet": "KINLAB",
  "DicomPort": 4242,

  "StableAge": 10,
  "StorageCompression": false
}
